@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EasyCaisse</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/print.css" />
    <style>

            body {
                margin: 0;
                background: #f5f7fb;
                font-family: 'Segoe UI',sans-serif;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 280px;
                height: 100vh;
                background: linear-gradient( 180deg, #003c97 0%, #1f4fa8 25%, #5d4f88 55%, #c7642c 80%, #ff7300 100% );
                color: white;
                overflow-y: auto;
            }

            .logo-area {
                padding: 20px;
                text-align: center;
            }

                .logo-area img {
                    width: 100%;
                    max-width: 220px;
                    background: white;
                    padding: 10px;
                    border-radius: 10px;
                }

            .menu-title {
                padding: 10px 25px;
                font-size: 12px;
                opacity: .8;
                text-transform: uppercase;
            }

            .sidebar .nav-link {
                color: white;
                padding: 15px 25px;
                margin: 5px 15px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: 15px;
                font-size: 18px;
                transition: .3s;
            }

                .sidebar .nav-link:hover {
                    background: rgba(255,255,255,.12);
                    transform: translateX(5px);
                }

                .sidebar .nav-link.active {
                    background: #2f78ff;
                    box-shadow: 0 5px 20px rgba(0,0,0,.15);
                }

            .content {
                margin-left: 280px;
                min-height: 100vh;
            }

            .topbar {
                background: white;
                height: 80px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                box-shadow: 0 2px 15px rgba(0,0,0,.05);
            }

            .page-content {
                padding: 30px;
            }

            .card-stat {
                border: none;
                border-radius: 20px;
                box-shadow: 0 2px 20px rgba(0,0,0,.05);
            }

            .icon-circle {
                width: 65px;
                height: 65px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
            }

            .bg-blue {
                background: #0d6efd;
            }

            .bg-orange {
                background: #ff7300;
            }

            .logout {
                margin: 20px;
                border: 1px solid rgba(255,255,255,.5);
                border-radius: 12px;
            }

                .logout a {
                    color: white;
                    display: block;
                    text-align: center;
                    padding: 15px;
                    text-decoration: none;
                }

    </style>

</head>
<body>

    <div class="sidebar">

        <div class="logo-area">
			<h2 class="mb-0">EasyCaisse</h2>
        </div>

        <div class="menu-title">
            Menu Principal
        </div>

        <nav class="nav flex-column">

            <a class="nav-link @(controller == "Dashboard" ? "active" : "")" href="/Dashboard/Index">
                <i class="fas fa-home"></i>
                Tableau de bord
            </a>

            <a class="nav-link @(controller == "Facture" ? "active" : "")" href="/Facture/Index">
                <i class="fas fa-file-invoice"></i>
                Factures
            </a>

            <a class="nav-link @(controller == "Client" ? "active" : "")" href="/Client/Index">
                <i class="fas fa-users"></i>
                Clients
            </a>
            <a class="nav-link @(controller == "Caisse" ? "active" : "")" href="/Caisse/Index">
                <i class="fas fa-cash-register"></i>
                Caisse
            </a>

            <a class="nav-link @(controller == "Rapport" ? "active" : "")" href="/Rapport/Operations">
                <i class="fas fa-chart-column"></i>
                Rapports
            </a>

            <a class="nav-link @(controller == "Utilisateur" ? "active" : "")" href="/Utilisateur/Index">
                <i class="fas fa-user-shield"></i>
                Utilisateurs
            </a>

            <a class="nav-link @(controller == "Parametre" ? "active" : "")" href="#">
                <i class="fas fa-gear"></i>
                Paramètres
            </a>

        </nav>

        <div class="logout">
            <a href="#">
                <i class="fas fa-power-off"></i>
                Déconnexion
            </a>
        </div>

    </div>

    <div class="content">

        <div class="topbar">

            <h4 class="mb-0">
                @ViewData["Title"]
            </h4>

            <div>

                <i class="fas fa-bell me-4"></i>

                <span>
                    Administrateur
                </span>

            </div>

        </div>

        <div class="page-content">

            @RenderBody()

        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>