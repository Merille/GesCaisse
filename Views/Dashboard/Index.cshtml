
@model EasytransitCaisse.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="container-fluid">

    <form asp-action="Index" method="get" class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-end">
                <div class="col-md-3">

                    <label class="form-label">
                        Caisse
                    </label>

                    <select asp-for="CaisseId"
                            asp-items="Model.ListeCaisses"
                            class="form-select">
                    </select>

                </div>
                <div class="col-md-2">

                    <label class="form-label">
                        Date début
                    </label>

                    <input asp-for="DateDebut"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        Date fin
                    </label>

                    <input asp-for="DateFin"
                           type="date"
                           class="form-control" />

                </div>
                <div class="col-md-2">

                    <label class="form-label">

                        Statut journée

                    </label>

                    <select asp-for="StatutJournee"
                            class="form-select">

                        <option value="">Toutes</option>

                        <option value="Ouverte">Ouvertes</option>

                        <option value="Cloturee">Clôturées</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <button class="btn btn-primary w-100">

                        <i class="fa fa-search"></i>

                        Filtrer

                    </button>

                </div>

            </div>

        </div>

    </form>

    <div class="row mb-4">

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex">

                    <div class="flex-grow-1">

                        <small class="text-muted">
                            MONTANT INITIAL
                        </small>

                        <h3 class="fw-bold text-primary mt-2">
                            @Model.SoldeCaisse.ToString("N0") FCFA
                        </h3>

                    </div>

                    <div class="align-self-center">

                        <div class="rounded-circle bg-primary text-white p-3">
                            <i class="fa fa-wallet fa-2x"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex">

                    <div class="flex-grow-1">

                        <small class="text-muted">
                            ENTRÉES
                        </small>

                        <h3 class="fw-bold text-success mt-2">
                            @Model.EntreesJour.ToString("N0") FCFA
                        </h3>

                    </div>

                    <div class="align-self-center">

                        <div class="rounded-circle bg-success text-white p-3">
                            <i class="fa fa-arrow-down fa-2x"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex">

                    <div class="flex-grow-1">

                        <small class="text-muted">
                            SORTIES
                        </small>

                        <h3 class="fw-bold text-danger mt-2">
                            @Model.SortiesJour.ToString("N0") FCFA
                        </h3>

                    </div>

                    <div class="align-self-center">

                        <div class="rounded-circle bg-danger text-white p-3">
                            <i class="fa fa-arrow-up fa-2x"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex">

                    <div class="flex-grow-1">

                        <small class="text-muted">
                            SOLDE CAISSE
                        </small>

                        <h3 class="fw-bold text-warning mt-2">
                            @Model.SoldeJour.ToString("N0") FCFA
                        </h3>

                    </div>

                    <div class="align-self-center">

                        <div class="rounded-circle text-white p-3"
                             style="background:linear-gradient(45deg,#0046c7,#ff7300);">

                            <i class="fa fa-coins fa-2x"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="fa fa-exchange-alt fa-3x text-primary mb-3"></i>

                    <h2>@Model.NombreOperations</h2>

                    <p class="text-muted">
                        Opérations
                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="fa fa-plus-circle fa-3x text-success mb-3"></i>

                    <h2>@Model.NombreEncaissements</h2>

                    <p class="text-muted">
                        Encaissements
                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="fa fa-minus-circle fa-3x text-danger mb-3"></i>

                    <h2>@Model.NombreDecaissements</h2>

                    <p class="text-muted">
                        Décaissements
                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="fa fa-users fa-3x text-warning mb-3"></i>

                    <h2>@Model.NombreUtilisateurs</h2>

                    <p class="text-muted">
                        Utilisateurs
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Dernières opérations
                    </h5>

                </div>

                <div class="card-body">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Date</th>

                                <th>Référence</th>

                                <th>Libellé</th>

                                <th>Type</th>

                                <th>Montant</th>

                                <th>Caissier</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.DernieresOperations)
                            {
                                <tr>

                                    <td>@item.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>@item.Reference</td>

                                    <td>@item.Libelle</td>

                                    <td>

                                        @if (item.TypeOperation == "Encaissement")
                                        {
                                            <span class="badge bg-success">
                                                Encaissement
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Décaissement
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @item.Montant.ToString("N0") FCFA

                                    </td>

                                    <td>

                                        @item.Caissier

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <!-- Situation mensuelle -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Situation du mois
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <div class="d-flex justify-content-between">

                            <span>
                                Encaissements
                            </span>

                            <strong class="text-success">
                                @Model.TotalEncaissementsMois.ToString("N0") FCFA
                            </strong>

                        </div>

                        <div class="progress mt-2" style="height:8px;">

                            <div class="progress-bar bg-success"
                                 style="width:80%">
                            </div>

                        </div>

                    </div>

                    <div class="mb-4">

                        <div class="d-flex justify-content-between">

                            <span>
                                Décaissements
                            </span>

                            <strong class="text-danger">
                                @Model.TotalDecaissementsMois.ToString("N0") FCFA
                            </strong>

                        </div>

                        <div class="progress mt-2" style="height:8px;">

                            <div class="progress-bar bg-danger"
                                 style="width:55%">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Statistiques -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Activité
                    </h5>

                </div>

                <div class="card-body">

                    <canvas id="chartOperations"
                            height="250">
                    </canvas>

                </div>

            </div>

            <!-- Informations -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        Informations

                    </h5>

                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <span>

                            Caisses ouvertes

                        </span>

                        <span class="badge bg-primary">

                            @Model.NombreCaissesOuvertes

                        </span>

                    </div>

                    <div class="d-flex justify-content-between mb-3">

                        <span>

                            Nombre d'utilisateurs

                        </span>

                        <span class="badge bg-success">

                            @Model.NombreUtilisateurs

                        </span>

                    </div>

                    <div class="d-flex justify-content-between mb-3">

                        <span>

                            Opérations du jour

                        </span>

                        <span class="badge bg-warning text-dark">

                            @Model.NombreOperations

                        </span>

                    </div>

                    <div class="d-flex justify-content-between">

                        <span>

                            Solde disponible

                        </span>

                        <strong class="text-primary">

                            @Model.SoldeCaisse.ToString("N0") FCFA

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const ctx=document.getElementById('chartOperations');

        new Chart(ctx,{

            type:'bar',

            data:{

                labels:[
                    'Encaissements',
                    'Décaissements'
                ],

                datasets:[{

                    label:'Montant',

                    data:[
                        @Model.TotalEncaissementsMois,
                        @Model.TotalDecaissementsMois
                    ],

                    backgroundColor:[
                        '#0d6efd',
                        '#ff7300'
                    ],

                    borderRadius:10

                }]

            },

            options:{

                responsive:true,

                maintainAspectRatio:false,

                plugins:{
                    legend:{
                        display:false
                    }
                },

                scales:{

                    y:{
                        beginAtZero:true
                    }

                }

            }

        });

    </script>

}