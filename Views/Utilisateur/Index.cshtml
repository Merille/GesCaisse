@model List<EasytransitCaisse.Models.Utilisateur>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Utilisateurs</h3>

        <a href="/Utilisateur/Create" class="btn btn-primary">
            + Nouvel utilisateur
        </a>
    </div>

    <div class="card shadow-sm">

        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nom utilisateur</th>
                    <th>Nom complet</th>
                    <th>Profil</th>
                    <th width="180">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.NomUtilisateur</td>
                        <td>@u.NomComplet</td>
                        <td>
                            <span class="badge bg-info">@u.Profil</span>
                        </td>
                        <td>
                            <a href="/Utilisateur/Edit/@u.Id" class="btn btn-warning btn-sm">
                                Modifier
                            </a>

                            <a href="/Utilisateur/Delete/@u.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Supprimer ?')">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>